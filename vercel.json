{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/healthz",
      "destination": "/api/health"
    },
    {
      "source": "/api/ping",
      "destination": "/api/health"
    },
    {
      "source": "/api/shop/:businessId/checkout",
      "destination": "/api/shop?businessId=:businessId&op=checkout"
    },
    {
      "source": "/api/shop/:businessId/orders",
      "destination": "/api/shop?businessId=:businessId&op=orders"
    },
    {
      "source": "/api/shop/:businessId",
      "destination": "/api/shop?businessId=:businessId"
    },
    {
      "source": "/api/public/shop-slug",
      "destination": "/api/shop?op=slug"
    },
    {
      "source": "/api/broadcast/preview",
      "destination": "/api/broadcast?op=preview"
    },
    {
      "source": "/api/broadcast",
      "destination": "/api/broadcast"
    },
    {
      "source": "/api/messenger/test-token",
      "destination": "/api/messenger?op=test-token"
    },
    {
      "source": "/api/messenger/subscribe-page",
      "destination": "/api/messenger?op=subscribe-page"
    },
    {
      "source": "/api/webhook/:businessId",
      "destination": "/api/webhook?businessId=:businessId"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/webhook/:businessId",
      "destination": "/api/webhook?businessId=:businessId"
    },
    {
      "source": "/messenger/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/messenger/webhook/:businessId",
      "destination": "/api/webhook?businessId=:businessId"
    },
    {
      "source": "/api/((?!webhook(?:/|$)).*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|webhook|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/webhook(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/webhook(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
