rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Admin Global Access
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'maraju924@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMerchantOf(businessData) {
      return isSignedIn() && request.auth.uid == businessData.ownerId;
    }

    function isMerchantByBizId(businessId) {
      return isSignedIn() && (
        businessId != null && 
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
      );
    }

    // --- Collection Routes ---

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if isAdmin() || isMerchantOf(resource.data);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (
        isMerchantOf(resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isAdmin() || isMerchantOf(resource.data);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || 
                   (isSignedIn() && (resource.data.ownerId == request.auth.uid || isMerchantByBizId(resource.data.businessId))) ||
                   (resource.data.sessionId != null);
      allow write: if isAdmin() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || isMerchantByBizId(resource.data.businessId)));
    }

    match /payments/{paymentId} {
      // Created/updated by the billing server (falls back to unauthenticated
      // client SDK when Admin credentials are absent). Token crediting is
      // verified against ZiniPay server-side before it happens.
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && isMerchantByBizId(resource.data.businessId));
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /abandoned_carts/{cartId} {
      allow create: if true;
      allow read: if true;
      allow write: if isAdmin() || isMerchantByBizId(resource.data.businessId);
    }

    match /broadcasts/{broadcastId} {
      allow create, read, write, list: if true;
    }

    match /customers/{customerId} {
      allow create: if true;
      allow read: if true;
      allow list: if true;
      allow update: if isAdmin() || isMerchantByBizId(resource.data.businessId) || true;
    }

    match /analytics/{eventId} {
      allow create: if true;
      allow read: if isAdmin() || isMerchantByBizId(resource.data.businessId);
    }

    match /system/{documentId} {
      allow read, write: if isAdmin();
    }

    match /system_config/public {
      // Public clients receive a sanitized subset from /api/public/config.
      // This document can contain operational settings and legacy credentials.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /system_config/config {
      allow read, write: if isAdmin();
    }

    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /system_logs/{logId} {
      allow create, read, write: if true; 
    }

    match /messenger_logs/{logId} {
      allow create, read, write: if true;
    }

    match /chats/{chatId} {
      allow create, read, write: if true;
    }

    match /chat_history/{msgId} {
      allow read, write: if true;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, write: if true;
    }
  }
}
