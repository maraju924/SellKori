# SellKori - Environment Variables Example

# Gemini AI API Key (Get it from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Usually handled via firebase-applet-config.json)
# If you want to use env vars in Vercel, you can add them below:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Optional: Firebase Admin credentials so the server can read the AI key pool
# Paste the full service-account JSON (or base64 of that JSON).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# FIREBASE_ADMIN_CREDENTIALS=
# MESSENGER_VERIFY_TOKEN=sellkori_verify_token
# WEBHOOK_VERIFY_TOKEN=
